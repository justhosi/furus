// Furus single-window form shell — slice S24-C C2 (S24-T2).
//
// This file is presentation only. Every model list, selection, enabled
// flag and visibility flag is a Rust-provided property (bound to
// `GuiState` in `src/main.rs`), and every interaction is forwarded to a
// callback that mutates `GuiState` in Rust. There are ZERO business
// rules here: no scheme/target/filesystem compatibility logic, no
// defaults, no conditional policy — the `.slint` file only renders what
// Rust hands it (contract 0.4.7, S24-T2).
//
// Static captions ("Device", "START", …) are layout chrome; every
// *value* string (combo models, status text, volume label, device info)
// comes from Rust.

import { Button, CheckBox, ComboBox, LineEdit, ProgressIndicator } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Furus";
    preferred-width: 700px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 520px;

    // ---- Rust -> UI (rendered from GuiState on every state change) ----
    in property <[string]> device-model;
    in-out property <string> device-current;
    in property <string> device-info;
    in property <[string]> boot-model;
    in-out property <string> boot-current;
    in property <bool> select-enabled;
    in property <bool> checksum-enabled;
    in property <bool> image-option-visible;
    in property <[string]> image-option-model;
    in-out property <string> image-option-current;
    in property <[string]> scheme-model;
    in-out property <string> scheme-current;
    in property <[string]> target-model;
    in-out property <string> target-current;
    in property <[string]> fs-model;
    in-out property <string> fs-current;
    in property <bool> fs-enabled;
    in property <[string]> cluster-model;
    in-out property <string> cluster-current;
    in-out property <string> volume-label;
    in-out property <bool> extended-label-checked;
    in-out property <bool> quick-format-checked;
    in-out property <bool> bad-blocks-checked;
    in property <[string]> passes-model;
    in-out property <string> passes-current;
    in property <bool> passes-enabled;
    in property <float> progress-value;
    in property <string> status-text;
    in property <bool> start-enabled;

    // ---- Slice 7: locale / i18n / GUI prefs (all values come from Rust) ----
    // Slint 1.19 has no RTL layout engine; `rtl` is used only for pure
    // presentation (text alignment), never for a business rule.
    in property <[string]> locale-model;
    in-out property <string> locale-current;
    in property <bool> rtl;
    in-out property <bool> advanced-visible;
    in-out property <bool> hash-md5-checked;
    in-out property <bool> hash-sha1-checked;
    in-out property <bool> hash-sha256-checked;
    in-out property <bool> hash-sha512-checked;
    // Static captions are translated in Rust; the English source ids live
    // in the Rust i18n bridge, not in this file.
    in property <string> caption-device;
    in property <string> caption-boot;
    in property <string> caption-partition;
    in property <string> caption-target;
    in property <string> caption-fs;
    in property <string> caption-cluster;
    in property <string> caption-format-options;

    // ---- S25 run wiring (all values/callbacks come from Rust) ----
    // One flag locks every configuration control while a run is in flight.
    in property <bool> form-enabled: true;
    in property <bool> confirm-visible: false;
    in property <string> confirm-facts;
    in property <bool> cancel-enabled: false;
    in property <string> step-text;
    in property <string> log-text;
    in-out property <bool> log-open: false;

    // ---- S25 slice 6 checksum modal (presentation only; all values from Rust) ----
    in property <bool> checksum-visible: false;
    in property <float> checksum-progress: 0;
    in property <[string]> checksum-digests;
    in property <string> checksum-status;
    in property <bool> checksum-cancel-enabled: false;

    // ---- UI -> Rust (every state change goes back through GuiState) ----
    callback device-selected(string);
    callback boot-selected(string);
    callback select-clicked();
    callback checksum-clicked();
    callback image-option-selected(string);
    callback scheme-selected(string);
    callback target-selected(string);
    callback fs-selected(string);
    callback cluster-selected(string);
    callback label-edited(string);
    callback extended-label-toggled();
    callback quick-format-toggled();
    callback bad-blocks-toggled();
    callback passes-selected(string);
    callback start-clicked();
    callback confirm-clicked();
    callback cancel-clicked();
    callback discard-clicked();
    callback close-clicked();
    callback checksum-cancel-clicked();
    callback checksum-close-clicked();
    callback locale-selected(string);
    callback hash-md5-toggled();
    callback hash-sha1-toggled();
    callback hash-sha256-toggled();
    callback hash-sha512-toggled();
    callback advanced-visible-toggled();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Locale selection: the model of display names and the mapping back
        // to locale tags are both provided by the Rust bridge.
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Language";
                vertical-alignment: center;
                width: 110px;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            ComboBox {
                model: root.locale-model;
                current-value <=> root.locale-current;
                selected(value) => { root.locale-selected(value); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.caption-device;
                vertical-alignment: center;
                width: 110px;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            device-combo := ComboBox {
                model: root.device-model;
                current-value <=> root.device-current;
                enabled: root.form-enabled;
                selected(value) => { root.device-selected(value); }
            }
        }

        Text {
            text: root.device-info;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.caption-boot;
                vertical-alignment: center;
                width: 110px;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            boot-combo := ComboBox {
                model: root.boot-model;
                current-value <=> root.boot-current;
                enabled: root.form-enabled;
                selected(value) => { root.boot-selected(value); }
            }
            Button {
                text: "SELECT";
                enabled: root.form-enabled && root.select-enabled;
                clicked => { root.select-clicked(); }
            }
            Button {
                text: "CHECKSUM";
                enabled: root.form-enabled && root.checksum-enabled;
                clicked => { root.checksum-clicked(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            visible: root.image-option-visible;
            Text {
                text: "Image option";
                vertical-alignment: center;
                width: 110px;
            }
            ComboBox {
                model: root.image-option-model;
                current-value <=> root.image-option-current;
                enabled: root.form-enabled;
                selected(value) => { root.image-option-selected(value); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.caption-partition;
                vertical-alignment: center;
                width: 110px;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            ComboBox {
                model: root.scheme-model;
                current-value <=> root.scheme-current;
                enabled: root.form-enabled;
                selected(value) => { root.scheme-selected(value); }
            }
            Text {
                text: root.caption-target;
                vertical-alignment: center;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            ComboBox {
                model: root.target-model;
                current-value <=> root.target-current;
                enabled: root.form-enabled;
                selected(value) => { root.target-selected(value); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.caption-fs;
                vertical-alignment: center;
                width: 110px;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            ComboBox {
                model: root.fs-model;
                current-value <=> root.fs-current;
                enabled: root.form-enabled && root.fs-enabled;
                selected(value) => { root.fs-selected(value); }
            }
            Text {
                text: root.caption-cluster;
                vertical-alignment: center;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            ComboBox {
                model: root.cluster-model;
                current-value <=> root.cluster-current;
                enabled: root.form-enabled;
                selected(value) => { root.cluster-selected(value); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Volume label";
                vertical-alignment: center;
                width: 110px;
            }
            LineEdit {
                text <=> root.volume-label;
                enabled: root.form-enabled;
                edited(value) => { root.label-edited(value); }
            }
        }

        CheckBox {
            text: "Create extended label and icon files";
            checked <=> root.extended-label-checked;
            enabled: root.form-enabled;
            toggled => { root.extended-label-toggled(); }
        }

        // Advanced-options visibility is a persisted GUI preference. The
        // checkbox only flips a display flag; every underlying toggle still
        // routes through its Rust callback.
        CheckBox {
            text: "Advanced options";
            checked <=> root.advanced-visible;
            toggled => { root.advanced-visible-toggled(); }
        }

        if root.advanced-visible : VerticalLayout {
            spacing: 8px;
            Text {
                text: root.caption-format-options;
                font-weight: 700;
                horizontal-alignment: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            CheckBox {
                text: "Quick format";
                checked <=> root.quick-format-checked;
                enabled: root.form-enabled;
                toggled => { root.quick-format-toggled(); }
            }
            HorizontalLayout {
                spacing: 8px;
                bad-blocks-check := CheckBox {
                    text: "Check device for bad blocks";
                    checked <=> root.bad-blocks-checked;
                    enabled: root.form-enabled;
                    toggled => { root.bad-blocks-toggled(); }
                }
                Text {
                    text: "passes";
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.passes-model;
                    current-value <=> root.passes-current;
                    enabled: root.form-enabled && root.passes-enabled;
                    selected(value) => { root.passes-selected(value); }
                }
            }
        }

        ProgressIndicator {
            progress: root.progress-value;
        }

        Text {
            text: root.step-text;
            wrap: word-wrap;
        }

        Text {
            text: root.status-text;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        Button {
            text: root.log-open ? "Hide log" : "Show log";
            clicked => { root.log-open = !root.log-open; }
        }
        if root.log-open : Rectangle {
            min-height: 120px;
            background: #f6f6f6;
            Flickable {
                content-height: log-text.preferred-height;
                log-text := Text {
                    text: root.log-text;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "CANCEL";
                enabled: root.cancel-enabled;
                clicked => { root.cancel-clicked(); }
            }
            Button {
                text: "START";
                enabled: root.form-enabled && root.start-enabled;
                clicked => { root.start-clicked(); }
            }
            Button {
                text: "CLOSE";
                clicked => { root.close-clicked(); }
            }
        }
    }

    // Destructive confirmation overlay. The facts are Rust-provided; this
    // layer only shows them and forwards the two choices. No rule lives here.
    if root.confirm-visible : Rectangle {
        background: #000000aa;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Rectangle {
                background: #ffffff;
                border-radius: 8px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "CONFIRM DESTRUCTIVE WRITE";
                        font-weight: 700;
                        font-size: 16px;
                    }
                    Text {
                        text: root.confirm-facts;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: "GO BACK";
                            clicked => { root.discard-clicked(); }
                        }
                        Button {
                            text: "CONFIRM AND WRITE";
                            clicked => { root.confirm-clicked(); }
                        }
                    }
                }
            }
        }
    }

    // Checksum modal. Rust owns the algorithms, progress, cancellation and
    // stale-result decisions; this layer only displays the four digests in
    // read-only (still selectable/copyable) fields and forwards two clicks.
    if root.checksum-visible : Rectangle {
        background: #000000aa;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Rectangle {
                background: #ffffff;
                border-radius: 8px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text {
                        text: "CHECKSUM";
                        font-weight: 700;
                        font-size: 16px;
                    }
                    Text {
                        text: root.checksum-status;
                        wrap: word-wrap;
                    }
                    ProgressIndicator {
                        progress: root.checksum-progress;
                    }
                    // Which digests are shown is a persisted GUI preference.
                    // The checkboxes only toggle display; hashing still runs
                    // for all four algorithms in the Rust worker.
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            text: "MD5";
                            checked <=> root.hash-md5-checked;
                            toggled => { root.hash-md5-toggled(); }
                        }
                        CheckBox {
                            text: "SHA-1";
                            checked <=> root.hash-sha1-checked;
                            toggled => { root.hash-sha1-toggled(); }
                        }
                        CheckBox {
                            text: "SHA-256";
                            checked <=> root.hash-sha256-checked;
                            toggled => { root.hash-sha256-toggled(); }
                        }
                        CheckBox {
                            text: "SHA-512";
                            checked <=> root.hash-sha512-checked;
                            toggled => { root.hash-sha512-toggled(); }
                        }
                    }
                    if root.hash-md5-checked : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "MD5";
                            vertical-alignment: center;
                            width: 70px;
                        }
                        LineEdit {
                            text: root.checksum-digests[0];
                            read-only: true;
                        }
                    }
                    if root.hash-sha1-checked : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SHA-1";
                            vertical-alignment: center;
                            width: 70px;
                        }
                        LineEdit {
                            text: root.checksum-digests[1];
                            read-only: true;
                        }
                    }
                    if root.hash-sha256-checked : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SHA-256";
                            vertical-alignment: center;
                            width: 70px;
                        }
                        LineEdit {
                            text: root.checksum-digests[2];
                            read-only: true;
                        }
                    }
                    if root.hash-sha512-checked : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SHA-512";
                            vertical-alignment: center;
                            width: 70px;
                        }
                        LineEdit {
                            text: root.checksum-digests[3];
                            read-only: true;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: "CANCEL";
                            enabled: root.checksum-cancel-enabled;
                            clicked => { root.checksum-cancel-clicked(); }
                        }
                        Button {
                            text: "CLOSE";
                            clicked => { root.checksum-close-clicked(); }
                        }
                    }
                }
            }
        }
    }
}
